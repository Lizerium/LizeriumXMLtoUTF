/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 210, 102
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About XMLUTF"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    LTEXT           "XMLUTF Version 3.0",IDC_PROGRAM_NAME,7,7,119,13,SS_NOPREFIX
    LTEXT           "Utility and Source Code placed in Public Domain 05-Nov-2004",IDC_STATIC,7,40,196,8
    DEFPUSHBUTTON   "OK",IDOK,153,7,50,14,WS_GROUP
    LTEXT           "by Sir Lancelot (a.k.a. Sirlancelot, Elvviis, Yud, vEct0r) & Adoxa & Dvurechensky",IDC_STATIC,7,60,172,8
    LTEXT           "XML to Freelancer UTF Conversion Utility",IDC_STATIC,7,21,131,8
    LTEXT           "on Lancers Reactor and https://dvurechensky.pro/",IDC_STATIC,7,50,180,8
    LTEXT           "and Jason Hood (a.k.a adoxa).",IDC_STATIC,7,74,98,8
    LTEXT           "and Dvurechensky.",IDC_STATIC,7,87,98,8
END

IDD_XMLUTF_DIALOG DIALOGEX 0, 0, 453, 126
STYLE DS_SETFONT | DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "XML to Freelancer UTF Conversion Utility"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    LTEXT           "Source Path",IDC_STATIC,7,8,40,8
    CONTROL         "Recursive",IDC_RECURSIVE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,68,7,48,10
    EDITTEXT        IDC_SOURCE_PATH,7,18,415,12,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BROWSE_SOURCE_PATH,429,17,11,14
    LTEXT           "Destination Path",IDC_STATIC,7,38,53,8
    CONTROL         "Create Subfolders",IDC_CREATE_SUBFOLDERS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,68,37,72,10
    EDITTEXT        IDC_DESTINATION_PATH,7,48,415,12,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BROWSE_DESTINATION_PATH,429,47,11,14
    LTEXT           "XML Filename",IDC_STATIC,8,68,46,8
    COMBOBOX        IDC_XML_FILENAMES,7,78,414,112,CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "...",IDC_BROWSE_XML_FILENAME,428,77,11,14
    PUSHBUTTON      "Help",IDC_HELP_BUTTON,113,101,50,18,NOT WS_VISIBLE
    DEFPUSHBUTTON   "Convert",IDC_CONVERT,173,101,50,18
    PUSHBUTTON      "Exit",IDCANCEL,396,101,50,18
END

IDD_PROGRESS_DIALOG DIALOG 0, 0, 251, 92
STYLE DS_SETFONT | DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "XML to UTF Conversion Progress"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Path:",IDC_STATIC,7,7,18,8
    EDITTEXT        IDC_PATH,7,17,237,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP
    LTEXT           "Progress:",IDC_STATIC,7,34,30,8
    CONTROL         "Progress1",IDC_PROGRESS,"msctls_progress32",WS_BORDER,7,44,237,14
    LTEXT           "Status:",IDC_STATIC,7,63,23,8
    EDITTEXT        IDC_STATUS,7,73,177,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP
    PUSHBUTTON      "Abort",IDCANCEL,194,71,50,14
END


